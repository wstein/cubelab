<section class="viewport-panel" data-viewport-panel aria-labelledby="viewport-title">
  <header class="viewport-header">
    <div>
      <span class="panel-label">Interactive preview</span>
      <h2 id="viewport-title" class="viewport-title">3D cube state</h2>
    </div>
    <div class="viewport-header-actions">
      <button
        type="button"
        class="viewport-control smart-cube-connect"
        data-smart-cube-connect
        title="Connect a supported Bluetooth smart cube"
      ><span aria-hidden="true">ᛒ</span> Connect cube</button>
      <button
        type="button"
        class="viewport-control active"
        data-turn-guides
        aria-pressed="true"
        title="Show direction guides when hovering timeline moves"
      >Turn guides</button>
      <button
        type="button"
        class="viewport-control active"
        data-smart-cube-sound
        aria-pressed="true"
        title="Toggle acoustic smart-cube feedback"
      >Sound on</button>
      <button
        type="button"
        class="viewport-control"
        data-auto-orbit
        aria-pressed="false"
        title="Rotate the camera automatically while the preview is visible"
      >Auto orbit</button>
      <button type="button" class="viewport-control" data-shortcuts-help aria-keyshortcuts="? H" title="Keyboard shortcuts (? or H)">Shortcuts</button>
      <button type="button" class="viewport-control" data-reset-camera aria-keyshortcuts="C" title="Reset view (C)">Reset view</button>
      <button type="button" class="viewport-control" data-snapshot-cube aria-keyshortcuts="Control+Shift+S" title="Copy 3D cube snapshot to clipboard or download (Ctrl/Cmd+Shift+S)">Snapshot</button>
      <button type="button" class="viewport-control" data-solve-card title="Copy a shareable card (cube image, Setup, Moves, Note) to clipboard or download">Solve card</button>
      <a class="viewport-control" href="/player" data-player-page-link title="Open the focused full-size player">Full-size player</a>
    </div>
  </header>
  <div class="smart-cube-dock" data-smart-cube-dock hidden>
    <span class="smart-cube-live-dot" data-smart-cube-live-dot aria-hidden="true"></span>
    <span class="smart-cube-status" data-smart-cube-status role="status" aria-live="polite">
      No smart cube connected
    </span>
    <span class="smart-cube-battery" data-smart-cube-record-capability hidden></span>
    <span class="smart-cube-battery" data-smart-cube-battery hidden></span>
    <span class="smart-cube-mistakes" data-smart-cube-mistakes hidden></span>
    <button
      type="button"
      class="viewport-control smart-cube-reroute"
      data-smart-cube-reroute
      title="Load the current physical state and generate a new Academy route"
      hidden
    >Re-route</button>
    <button
      type="button"
      class="viewport-control smart-cube-sync"
      data-smart-cube-sync
      title="Read the physical cube state into the input"
      hidden
    >Sync state</button>
    <button
      type="button"
      class="viewport-control smart-cube-reset-state"
      data-smart-cube-reset-state
      title="Use only when the physical cube is solved; resets its tracker and creates a local solved baseline without reading facelets"
      hidden
    >Set state to solved</button>
    <button
      type="button"
      class="viewport-control smart-cube-orientation"
      data-smart-cube-orientation
      aria-pressed="false"
      title="Track the physical cube orientation"
      hidden
    >Track orientation</button>
    <button
      type="button"
      class="viewport-control smart-cube-recenter"
      data-smart-cube-recenter
      title="Recenter gyro view without changing cube state (or flick R then R' rapidly)"
      hidden
    >Recenter gyro view</button>
    <button
      type="button"
      class="viewport-control"
      data-smart-cube-diagnostics
      aria-pressed="false"
      title="Opt in to a local diagnostic trace; it is never uploaded automatically"
      hidden
    >Diagnostics off</button>
    <button
      type="button"
      class="viewport-control"
      data-smart-cube-copy-trace
      title="Copy the local diagnostic trace to attach to a support report"
      hidden
    >Copy cube trace</button>
    <button
      type="button"
      class="viewport-control smart-cube-controller"
      data-smart-cube-controller
      aria-pressed="false"
      title="Use the smart cube as a virtual-cube controller; physical stickers are ignored"
      hidden
    >🎮 Controller mode</button>
    <button
      type="button"
      class="viewport-control smart-cube-mac-recovery"
      data-smart-cube-mac-recovery
      title="Retry an encrypted smart cube with Bluetooth MAC-address recovery"
      hidden
    >Encrypted-cube recovery</button>
    <button
      type="button"
      class="viewport-control smart-cube-disconnect"
      data-smart-cube-disconnect
      hidden
    >Disconnect</button>
  </div>
  <div class="viewport-stage" data-viewport-stage>
    <canvas
      class="cube-canvas"
      data-cube-canvas
      tabindex="0"
      aria-label="Interactive three-dimensional cube preview. Drag to rotate and scroll to zoom."
    ></canvas>
    <canvas
      class="motion-overlay"
      data-motion-overlay
      aria-hidden="true"
    ></canvas>
    <div class="viewport-fallback" data-viewport-fallback role="status" hidden>
      WebGL is unavailable. Text conversions remain fully functional.
    </div>
    <button class="timer-cover" data-timer-cover type="button" hidden>
      <span>Virtual scramble covered</span>
      <strong>Inspect</strong>
      <small>Press Space or tap to begin 15-second inspection</small>
    </button>
    <aside class="timer-hud" data-timer-hud hidden aria-live="polite">
      <span class="panel-label" data-timer-hud-phase>Covered</span>
      <strong data-timer-hud-time>0.00</strong>
      <span data-timer-hud-status>Press Inspect to reveal the cube</span>
      <small data-timer-hud-stats>Best — · Ao5 —</small>
    </aside>
    <span class="viewport-hint">Drag to rotate · Scroll to zoom</span>
  </div>
  <div class="viewport-footer">
    <div class="segmented-control" aria-label="Cube surface style">
      <button type="button" class="segmented-btn active" data-cube-style="Standard" aria-pressed="true">
        Standard
      </button>
      <button type="button" class="segmented-btn" data-cube-style="Speed" aria-pressed="false">
        Speedcube
      </button>
    </div>
  </div>
  <section class="playback" data-playback aria-label="Algorithm playback" hidden>
    <span class="visually-hidden" data-coach-status aria-live="polite"></span>
    <div class="playback-heading">
      <span class="panel-label">Move tape</span>
      <span class="playback-metrics" aria-live="polite">
        <span><abbr title="Execution Turn Metric">ETM</abbr> <span class="playback-position" data-playback-position>Move 0 of 0</span></span>
        <span><abbr title="Half Turn Metric">HTM</abbr> <span data-playback-htm>0 of 0</span></span>
      </span>
    </div>
    <div class="move-ribbon" data-move-ribbon aria-label="Move tape steps"></div>
    <input
      class="playback-scrubber"
      data-playback-scrubber
      type="range"
      min="0"
      max="0"
      value="0"
      aria-label="Algorithm position"
    />
    <div class="playback-controls">
      <div class="playback-transport" role="group" aria-label="Playback transport">
        <button type="button" class="transport-btn transport-terminal" data-playback-begin aria-label="Go to beginning" aria-keyshortcuts="Home" title="Go to beginning (Home)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-bar"></i><i class="transport-triangle left"></i></span>
        </button>
        <button type="button" class="transport-btn transport-step" data-playback-back aria-label="Step backward" aria-keyshortcuts="ArrowLeft" title="Step backward one move (←)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-triangle left"></i><i class="transport-bar"></i></span>
        </button>
        <button type="button" class="transport-btn transport-playback" data-playback-reverse aria-label="Play backward" title="Play backward">
          <span class="transport-icon" aria-hidden="true"><i class="transport-triangle left"></i></span>
        </button>
        <button type="button" class="transport-btn transport-pause transport-hero" data-playback-pause aria-label="Pause playback" aria-keyshortcuts="Space" title="Pause playback (Space)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-bar"></i><i class="transport-bar"></i></span>
        </button>
        <button type="button" class="transport-btn transport-playback" data-playback-play aria-label="Play forward" aria-keyshortcuts="Space" title="Play forward (Space)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-triangle right"></i></span>
        </button>
        <button type="button" class="transport-btn transport-step" data-playback-forward aria-label="Step forward" aria-keyshortcuts="ArrowRight" title="Step forward one move (→)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-bar"></i><i class="transport-triangle right"></i></span>
        </button>
        <button type="button" class="transport-btn transport-terminal" data-playback-end aria-label="Go to end" aria-keyshortcuts="End" title="Go to end (End)">
          <span class="transport-icon" aria-hidden="true"><i class="transport-triangle right"></i><i class="transport-bar"></i></span>
        </button>
        <button
          type="button"
          class="transport-btn transport-guide"
          data-playback-guide
          aria-label="Guide turns with smart cube"
          aria-pressed="false"
          title="Connect a 2×2 or 3×3 smart cube to guide the next tape turn"
          disabled
        ><span aria-hidden="true">◇</span><span class="visually-hidden">Guide turns with smart cube</span></button>
        <button
          type="button"
          class="transport-btn transport-record"
          data-playback-record
          aria-label="Start smart-cube recording"
          aria-pressed="false"
          title="Connect a smart cube to record physical turns"
          disabled
        ><span aria-hidden="true">●</span><span class="visually-hidden">Record</span></button>
      </div>
      <div class="playback-options">
        <div
          class="segmented-control compact"
          data-coaching-controls
          aria-label="Academy playback style"
          hidden
        >
          <button
            type="button"
            class="segmented-btn active"
            data-coaching-mode="coached"
            aria-pressed="true"
          >Coached</button>
          <button
            type="button"
            class="segmented-btn"
            data-coaching-mode="continuous"
            aria-pressed="false"
          >Continuous</button>
        </div>
        <div class="segmented-control compact" aria-label="Playback speed">
          {[0.2, 0.5, 1, 2, 5, 10].map((speed) => (
            <button
              type="button"
              class:list={["segmented-btn", {active: speed === 1}]}
              data-playback-speed={speed}
              aria-pressed={speed === 1 ? "true" : "false"}
            >
              {speed}×
            </button>
          ))}
        </div>
        <button type="button" class="loop-btn" data-playback-loop aria-pressed="false">Loop</button>
      </div>
    </div>
    <p class="playback-limit" data-playback-limit hidden></p>
  </section>
  <dialog class="shortcuts-dialog" data-shortcuts-dialog aria-labelledby="shortcuts-title">
    <div class="shortcuts-dialog-header">
      <div>
        <span class="panel-label">Direct notation mode</span>
        <h3 id="shortcuts-title">Keyboard shortcuts</h3>
      </div>
      <button type="button" class="viewport-control" data-shortcuts-close aria-label="Close shortcuts">Close</button>
    </div>
    <dl class="shortcut-grid">
      <div><dt>R U F L D B</dt><dd>Clockwise face turn</dd></div>
      <div><dt>Shift + face</dt><dd>Counter-clockwise face turn</dd></div>
      <div><dt>Alt + face / W then face</dt><dd>Wide turn</dd></div>
      <div><dt>Double tap / 2</dt><dd>Half turn</dd></div>
      <div><dt>M E S</dt><dd>Slice turn</dd></div>
      <div><dt>X Y Z</dt><dd>Whole-cube rotation</dd></div>
      <div><dt>Space</dt><dd>Play or pause</dd></div>
      <div><dt>← / →</dt><dd>Step one move</dd></div>
      <div><dt>Shift + ← / →</dt><dd>Previous or next sequence</dd></div>
      <div><dt>Home / End</dt><dd>Beginning or end</dd></div>
      <div><dt>C</dt><dd>Reset camera</dd></div>
      <div><dt>Esc</dt><dd>Stop and clear focus</dd></div>
    </dl>
    <p>Shortcuts are suspended while editing text or form controls.</p>
  </dialog>
</section>
