---
import "../styles/global.css";
import CubeViewport from "../Components/CubeViewport.astro";

interface Props {
  initialTab?: "converter" | "academy" | "workbench" | "patterns" | "timer";
  initialPlayer?: boolean;
  pageTitle?: string;
  metaDescription?: string;
}

const {
  initialTab = "converter",
  initialPlayer = false,
  pageTitle = "CubeLab — Interactive Cube Studio & Algorithmic Suite",
  metaDescription = "Convert Rubik's Cube states between facelets, ASCII nets, colour notation, cubie coordinates, Singmaster cycle notation, and Orbit64.",
} = Astro.props;

const cards = [
  {
    key: "facelets",
    title: "Compact Facelets",
    provenance: "Kociemba URFDLB row-major convention",
  },
  {
    key: "net",
    title: "Standard 2D Net",
    provenance: "Canonical U / L-F-R-B / D cross layout",
  },
  {
    key: "colours",
    title: "Compact Colours",
    provenance: "Facelets mapped through the active colour scheme",
  },
  {
    key: "colour-net",
    title: "Colour 2D Net",
    provenance: "Canonical cross layout using colour letters",
  },
  {
    key: "pieces",
    title: "3×3 CP / CO / EP / EO",
    provenance: "Kociemba piece order · canonical centre frame",
    sizes: "2,3",
  },
  {
    key: "orbit64",
    title: "Orbit64",
    provenance: "Flix Orbit64 state coordinates · Base64URL · 2×2–5×5",
    sizes: "2,3,4,5",
  },
  {
    key: "sse",
    title: "SSE Cubie State",
    provenance: "CubeTwister / Superset ENG cycles and orientation markers",
    sizes: "2,3",
  },
  {
    key: "singmaster",
    title: "Singmaster Cycle Notation",
    provenance: "Corner and edge permutation cycles with +/- orientation markers · directly pasteable into Setup",
    sizes: "2,3",
  },
  {
    key: "acube",
    title: "ACube Positional State",
    provenance: "ACube 4 · 12 edges followed by 8 corners",
    sizes: "3",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#111827" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class={initialPlayer ? "player-page" : undefined}>
    <main class="container" data-converter data-initial-tab={initialTab}>
      <header class="site-header">
        <div class="brand-lockup">
          <span class="badge-tag">2×2×2 — 5×5×5</span>
          <div>
            <h1 class="title-gradient">CubeLab</h1>
            <p class="subtitle">
              Strict cube-state conversion, algorithm workbench, and interactive
              solvers.
            </p>
          </div>
        </div>
        <div class="header-actions">
          <nav class="workspace-tabs" aria-label="CubeLab workspace">
            <button
              type="button"
              class:list={[
                "workspace-tab",
                { active: initialTab === "converter" },
              ]}
              data-workspace-tab="converter"
              aria-selected={initialTab === "converter" ? "true" : "false"}
            >
              🔄 Converter
            </button>
            <button
              type="button"
              class:list={[
                "workspace-tab",
                { active: initialTab === "academy" },
              ]}
              data-workspace-tab="academy"
              aria-label="Academy"
              aria-selected={initialTab === "academy" ? "true" : "false"}
            >
              🎓 Academy
            </button>
            <button
              type="button"
              class:list={[
                "workspace-tab",
                { active: initialTab === "workbench" },
              ]}
              data-workspace-tab="workbench"
              aria-selected={initialTab === "workbench" ? "true" : "false"}
            >
              ⚡ Alg Workbench
            </button>
            <button
              type="button"
              class:list={[
                "workspace-tab",
                { active: initialTab === "patterns" },
              ]}
              data-workspace-tab="patterns"
              aria-selected={initialTab === "patterns" ? "true" : "false"}
            >
              🧩 Pattern Catalog
            </button>
            <button
              type="button"
              class:list={["workspace-tab", { active: initialTab === "timer" }]}
              data-workspace-tab="timer"
              aria-selected={initialTab === "timer" ? "true" : "false"}
            >
              ⏱ Timer
            </button>
          </nav>
          <button
            type="button"
            class="viewport-control settings-trigger"
            data-settings-open
            aria-label="Settings"
            title="Settings">⚙</button
          >
        </div>
      </header>

      <section class="studio">
        <div class="studio-controls">
          <section
            class="toolbar compact-toolbar"
            aria-label="Converter settings"
          >
            <div class="toolbar-group">
              <span class="panel-label">Puzzle size</span>
              <div class="segmented-control" data-size-control>
                {
                  [2, 3, 4, 5].map((size) => (
                    <button
                      type="button"
                      class:list={["segmented-btn", { active: size === 3 }]}
                      data-size={size}
                      aria-pressed={size === 3 ? "true" : "false"}
                    >
                      {size}×{size}×{size}
                    </button>
                  ))
                }
              </div>
            </div>

            <div class="toolbar-group">
              <label class="panel-label" for="scheme">Colour scheme</label>
              <select id="scheme" class="select-control" data-scheme>
                <option value="Western">Western (BOY)</option>
                <option value="Japanese">Japanese</option>
                <option value="Custom">Custom</option>
              </select>
              <label class="visually-hidden" for="custom-scheme"
                >Custom mapping in U,L,F,R,B,D order</label
              >
              <input
                id="custom-scheme"
                class="select-control custom-scheme-input"
                data-custom-scheme
                value="WOGRBY"
                maxlength="6"
                spellcheck="false"
                aria-label="Custom mapping in U,L,F,R,B,D order"
                hidden
              />
            </div>

            <div class="toolbar-group" data-lowercase-controls hidden>
              <span class="panel-label">Lowercase moves</span>
              <div
                class="segmented-control"
                aria-label="Lowercase move interpretation"
              >
                <button
                  type="button"
                  class="segmented-btn active"
                  data-lowercase-mode="Wide"
                  aria-pressed="true"
                >
                  Wide (r = Rw)
                </button>
                <button
                  type="button"
                  class="segmented-btn"
                  data-lowercase-mode="InnerSlice"
                  aria-pressed="false"
                >
                  Inner slice (r = 2R)
                </button>
              </div>
            </div>

            <div class="toolbar-group" data-notation-controls hidden>
              <span class="panel-label">Layer syntax</span>
              <div
                class="segmented-control"
                aria-label="Numbered layer notation"
              >
                <button
                  type="button"
                  class="segmented-btn active"
                  data-notation-dialect="Modern"
                  aria-pressed="true"
                >
                  SiGN prefix (2R)
                </button>
                <button
                  type="button"
                  class="segmented-btn"
                  data-notation-dialect="Ruwix"
                  aria-pressed="false"
                >
                  Ruwix suffix (R₂)
                </button>
              </div>
            </div>
          </section>

          <section class="input-panel">
            <div class="input-header">
              <label class="panel-label" for="cube-input">Setup (state)</label>
              <div class="input-header-actions">
                <span class="sniffer-badge" data-status aria-live="polite"
                  >Solved default</span
                >
                <span class="sniffer-badge setup-orientation-badge" data-setup-orientation hidden aria-live="polite"></span>
                <button
                  type="button"
                  class="copy-btn setup-canonicalise"
                  data-setup-canonicalise
                  title="Rewrite this valid 3×3 state into CubeLab's canonical U/R/F centre frame"
                  hidden
                >Canonicalise orientation</button>
                <button
                  type="button"
                  class="copy-btn"
                  data-copy="facelets"
                  data-copy-facelets>Copy as compact facelets</button
                >
                <button
                  type="button"
                  class="copy-btn input-orbit-copy"
                  data-copy="orbit64"
                  data-copy-orbit64>Copy as Orbit64</button
                >
                <button
                  type="button"
                  class="copy-btn"
                  data-manual-state-open
                  title="Build a cube state sticker by sticker"
                >Enter state by hand</button>
              </div>
            </div>
            <textarea
              id="cube-input"
              class="cube-textarea setup-textarea"
              data-input
              rows="1"
              wrap="off"
              placeholder="Paste facelets, colours, a net, cubie coordinates, Singmaster cycles, Orbit64, SSE cubie cycles, or ACube states. Smart-cube Sync loads this field. Leave blank for solved."
              spellcheck="false"></textarea>
            <label class="moves-input-label" for="cube-moves">Moves</label>
            <textarea
              id="cube-moves"
              class="cube-textarea moves-textarea"
              data-moves-input
              placeholder="Optional moves or a bounded macro program, e.g. R U R' U'"
              spellcheck="false"></textarea>
            <p class="input-help">
              Setup accepts a cube state or an algorithm; Sync state replaces it
              from the connected smart cube. Moves replay from the resolved
              Setup state, including when Setup is written as an algorithm.
              Leave Moves empty to inspect Setup alone. Macro definitions in Moves are lazily expanded into
              the regular tape only when they contain at most 500 moves; use the
              Hamilton streaming player for longer programs. Lowercase moves use
              modern SiGN wide turns by default; ambiguous plaintext such as R2'
              requires Ruwix suffix mode.
            </p>
            <label class="note-input-label" for="cube-note"
              >Note <span class="note-input-hint">(optional, shared in the link)</span></label
            >
            <input
              id="cube-note"
              type="text"
              class="select-control note-input"
              data-note-input
              maxlength="200"
              placeholder="Add a short note for anyone opening this link"
              spellcheck="false"
            />
            <div class="transform-row" aria-label="Two-phase solver">
              <span class="transform-label">3×3 solver</span>
              <label class="two-phase-target-input">
                Target (optional)
                <input
                  type="text"
                  data-two-phase-target
                  placeholder="Solved"
                  spellcheck="false"
                />
              </label>
              <button type="button" class="transform-btn" data-two-phase-solve>
                Find two-phase solution
              </button>
              <button
                type="button"
                class="transform-btn"
                data-two-phase-apply
                disabled
              >
                Apply solution
              </button>
              <output
                class="niss-result"
                data-two-phase-result
                aria-live="polite"
              >
                Solve the Setup 3×3 state in the background.
              </output>
            </div>
            <div class="transform-row" data-optimal-2x2-row aria-label="Optimal 2×2 solver" hidden>
              <span class="transform-label">2×2 solver</span>
              <button type="button" class="transform-btn" data-optimal-2x2-solve>
                Find optimal solution
              </button>
              <button type="button" class="transform-btn" data-optimal-2x2-apply disabled>
                Apply solution
              </button>
              <output class="niss-result" data-optimal-2x2-result aria-live="polite">
                Find an HTM-optimal solution for the Setup state.
              </output>
            </div>
            <div class="transform-row" data-reduction-4x4-row aria-label="4×4 reduction solver" hidden>
              <span class="transform-label">4×4 solver</span>
              <button type="button" class="transform-btn" data-reduction-4x4-solve>
                Finish reduced state
              </button>
              <button type="button" class="transform-btn" data-reduction-4x4-apply disabled>
                Apply solution
              </button>
              <output class="niss-result" data-reduction-4x4-result aria-live="polite">
                Solve centres and pair wings first, then finish the reduced 4×4.
              </output>
            </div>
            <div
              class="transform-row"
              data-workspace-panel="workbench"
              aria-label="Algorithm transformations"
              hidden
            >
              <span class="transform-label">Transforms</span>
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="invert"
                disabled>↶ Invert</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="simplify"
                disabled>⚡ Simplify</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="normalize"
                title="Rewrite in CubeLab's canonical notation without changing the move sequence"
                disabled>🧭 Normalize</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="unfold-slices"
                title="Replace M, E, and S with their exact size-aware inner-layer turns"
                disabled>⇲ Unfold slices</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="unfold"
                title="Materialize a bounded Hamilton macro program into plain moves"
                disabled>⇲ Unfold macros</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="mirror-lr"
                disabled>↔ Mirror L/R</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="mirror-fb"
                disabled>↕ Mirror F/B</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="mirror-ud"
                disabled>⇅ Mirror U/D</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="rotate-x"
                disabled>↻ Rotate x</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="rotate-y"
                disabled>↻ Rotate y</button
              >
              <button
                type="button"
                class="transform-btn"
                data-alg-transform="rotate-z"
                disabled>↻ Rotate z</button
              >
            </div>
            <div class="shorten-panel" data-workspace-panel="workbench" hidden>
              <button
                type="button"
                class="transform-btn"
                data-shorten-search
                title="Bounded search for a strictly shorter equivalent algorithm (3×3 only)"
                disabled>🔍 Try to shorten</button
              >
              <p class="shorten-hint">
                Bounded search, 3×3 only. It may report no shorter equivalent
                within its search budget even when one exists.
              </p>
              <div class="shorten-result" data-shorten-result hidden>
                <span data-shorten-summary></span>
                <code class="shorten-preview" data-shorten-preview></code>
                <div class="shorten-actions">
                  <button
                    type="button"
                    class="transform-btn"
                    data-shorten-apply
                  >
                    Apply
                  </button>
                  <button
                    type="button"
                    class="transform-btn"
                    data-shorten-dismiss
                  >
                    Dismiss
                  </button>
                </div>
              </div>
            </div>
            <details
              class="niss-panel"
              data-niss-panel
              data-workspace-panel="workbench"
              hidden
            >
              <summary>NISS helper (3×3 FMC)</summary>
              <p class="niss-help">
                Record normal-side moves as <code>N</code> and inverse-side moves
                as
                <code>I</code>. CubeLab constructs <code>N · I⁻¹</code> and accepts
                it only when replay proves that it solves the current scramble.
              </p>
              <div class="niss-actions" aria-label="NISS workspace side">
                <button
                  type="button"
                  class="transform-btn active"
                  data-niss-side="normal"
                  aria-pressed="true"
                >
                  Normal scramble
                </button>
                <button
                  type="button"
                  class="transform-btn"
                  data-niss-side="inverse"
                  aria-pressed="false"
                >
                  ⇄ Inverse scramble
                </button>
                <span class="niss-field-label" data-niss-virtual-badge hidden
                  >Virtual inverse state</span
                >
              </div>
              <div class="niss-inverse-row">
                <span class="niss-field-label">Inverse scramble</span>
                <code class="niss-code" data-niss-inverse>—</code>
                <button
                  type="button"
                  class="transform-btn"
                  data-niss-use-inverse
                  disabled
                >
                  Use inverse
                </button>
              </div>
              <div class="niss-fields">
                <label>
                  <span class="niss-field-label">Normal-side moves (N)</span>
                  <textarea
                    class="niss-textarea"
                    data-niss-normal
                    rows="2"
                    spellcheck="false"></textarea>
                </label>
                <label>
                  <span class="niss-field-label">Inverse-side moves (I)</span>
                  <textarea
                    class="niss-textarea"
                    data-niss-inverse-moves
                    rows="2"
                    spellcheck="false"></textarea>
                </label>
              </div>
              <div class="niss-actions">
                <button
                  type="button"
                  class="transform-btn"
                  data-niss-verify
                  disabled
                >
                  Recombine and verify
                </button>
                <button
                  type="button"
                  class="transform-btn"
                  data-niss-load
                  disabled
                >
                  Preview recombined solution
                </button>
              </div>
              <output class="niss-result" data-niss-result aria-live="polite">
                Enter both sides to verify a candidate solution.
              </output>
            </details>
            <details
              class="niss-panel"
              data-hamilton-panel
              data-workspace-panel="workbench"
              hidden
            >
              <summary>Hamilton macro inspector</summary>
              <p class="niss-help">
                Inspect recursive <code>def</code>/<code>export</code> programs without
                unfolding them. Import <code>.alg</code> or legacy <code
                  >.orbit64</code
                > sources, then select a node to measure or preview a bounded move
                window.
              </p>
              <label class="file-input-label">
                Import macro source
                <input
                  type="file"
                  data-hamilton-import
                  accept=".alg,.orbit64,text/plain"
                />
              </label>
              <textarea
                class="niss-textarea"
                data-hamilton-input
                rows="5"
                spellcheck="false"
                placeholder="s100 = ([R',U]6 [F:D']@0.6s)100
s100"></textarea>
              <div class="niss-actions">
                <button
                  type="button"
                  class="transform-btn"
                  data-hamilton-inspect>Inspect macros</button
                >
                <select
                  data-hamilton-node
                  aria-label="Hamilton macro node"
                  disabled></select>
                <label class="niss-field-label hamilton-window-field">
                  Start (zero-based)
                  <input
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    value="0"
                    data-hamilton-window-start
                    aria-label="Hamilton preview start"
                    disabled
                  />
                </label>
                <label class="niss-field-label hamilton-window-field">
                  Moves
                  <input
                    type="number"
                    min="1"
                    max="500"
                    value="100"
                    data-hamilton-window-length
                    aria-label="Hamilton preview length"
                    disabled
                  />
                </label>
                <button
                  type="button"
                  class="transform-btn"
                  data-hamilton-preview
                  disabled>Preview window</button
                >
                <button
                  type="button"
                  class="transform-btn"
                  data-hamilton-stream
                  disabled>Start streaming player</button
                >
              </div>
              <output
                class="niss-result"
                data-hamilton-result
                aria-live="polite"
              >
                Parse a Hamilton macro program to measure its exported root.
              </output>
            </details>
            <details
              class="niss-panel"
              data-acube-generator-panel
              data-workspace-panel="workbench"
              hidden
            >
              <summary>ACube state generator</summary>
              <p class="niss-help">
                Generate a complete, legal 3×3 state from ACube cycles, positional
                notation, unknown orientations, and ignored-piece masks. Setup stays
                strict; this panel materializes a chosen seeded completion.
              </p>
              <textarea
                class="niss-textarea"
                data-acube-generator-input
                rows="3"
                spellcheck="false"
                placeholder="(UL UR) (UFR URB) [DF DL DR DB] UF? UB?"></textarea>
              <div class="niss-actions">
                <label class="niss-field-label hamilton-window-field">
                  Seed
                  <input type="text" value="acube-1" data-acube-generator-seed spellcheck="false" />
                </label>
                <label class="niss-field-label hamilton-window-field">
                  Completion
                  <select data-acube-generator-choice aria-label="ACube generated completion" disabled></select>
                </label>
                <button type="button" class="transform-btn" data-acube-generator-run disabled>Load selected state</button>
                <button type="button" class="transform-btn" data-acube-generator-next>Refresh choices</button>
              </div>
              <output class="niss-result" data-acube-generator-result aria-live="polite">
                Enter an ACube definition to generate a legal completion.
              </output>
            </details>
            <p class="input-help">
              Lowercase moves use modern SiGN wide turns by default (<code
                >r = Rw</code
              >). Use <code>2R</code> for a portable single inner-layer turn. Unicode
              Ruwix subscripts such as <code>R₂'</code> are recognized directly; ambiguous
              plaintext such as <code>R2'</code> requires Ruwix suffix mode. Practice
              scramble is quick-load testing only, not official WCA scramble data.
              <strong>Simplify</strong> resolves nested repeat/invert notation algebraically
              (<code>(U3')2'</code> → <code>U2</code>) as well as merging
              adjacent same-face turns. <strong>Normalize</strong> rewrites the same
              move sequence in CubeLab's canonical spelling without merging or expanding
              anything.
            </p>
            <div class="compatibility-strip" data-compatibility hidden>
              <span class="compatibility-label">Source compatibility</span>
              <div
                class="compatibility-badges"
                aria-label="Notation source compatibility"
              >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="wca"
                  tabindex="0">WCA tokens</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="signLgn"
                  tabindex="0">SiGN / LGN</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="cubingJs"
                  tabindex="0">cubing.js / Twizzle</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="speedsolving"
                  tabindex="0">SpeedSolving Wiki</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="ruwix"
                  tabindex="0">Ruwix Advanced</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="sse"
                  tabindex="0">SSE / CubeTwister</span
                >
                <span
                  class="compatibility-pill"
                  data-compatibility-profile="acube"
                  tabindex="0">ACube 4</span
                >
              </div>
            </div>
            <div class="preset-row" aria-label="Example algorithms">
              <span class="preset-label">Quick load</span>
              <button type="button" class="preset-chip" data-preset=""
                >Solved</button
              >
              <button
                type="button"
                class="preset-chip"
                data-preset="M2 E2 S2"
                data-preset-size="3"
                title="Checkerboard (Pons Asinorum) · Alternating 3x3 dual-color grid"
                >🏁 Checkerboard</button
              >
              <button
                type="button"
                class="preset-chip"
                data-preset="((M' U)4 x y)2 (M' U)4"
                data-preset-size="3"
                title="Superflip · 20-move maximum distance antipode (all 12 edges flipped in place)"
                >🌌 Superflip</button
              >
              <button
                type="button"
                class="preset-chip"
                data-preset="F L F U' R U F2 L2 U' L' B D' B' L2 U"
                data-preset-size="3"
                title="Cube in a Cube · Embedded 2x2 miniature sub-cube inside 3x3"
                >🎲 Cube in Cube</button
              >
              <button
                type="button"
                class="preset-chip"
                data-preset="U D' R L' F B' U D'"
                data-preset-size="3"
                title="Six Spots (Center Dots) · Swaps all 6 face centers"
                >🎯 Six Spots</button
              >
              <button
                type="button"
                class="preset-chip"
