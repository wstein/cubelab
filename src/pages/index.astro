              <option value="Acube">ACube 4 (3×3 state / e-s-m rotations)</option>
            </select>
          </label>
        </section>
        <section class="settings-section">
          <h4>3D Viewport</h4>
          <div class="settings-row">
            <span class="settings-row-label">Auto-orbit</span>
            <button
              type="button"
              class="viewport-control"
              data-settings-auto-orbit
              aria-pressed="false">Off</button
            >
          </div>
          <div class="settings-row">
            <span class="settings-row-label">Playback / turn speed</span>
            <div
              class="segmented-control compact"
              aria-label="Playback and turn speed"
            >
              {
                [0.2, 0.5, 1, 2, 5, 10].map((speed) => (
                  <button
                    type="button"
                    class:list={["segmented-btn", { active: speed === 1 }]}
                    data-playback-speed={speed}
                    aria-pressed={speed === 1 ? "true" : "false"}
                  >
                    {speed}×
                  </button>
                ))
              }
            </div>
          </div>
        </section>
        <section class="settings-section">
          <h4>Scramble &amp; Timer</h4>
          <p class="settings-hint">
            Use a locally running TNoodle server for WCA 3×3 scramble batches.
            CubeLab falls back to its built-in practice generator when it is
            disabled, unavailable, or returns an invalid response.
          </p>
          <div class="settings-row">
            <span class="settings-row-label">Use TNoodle scrambles</span>
            <button
              type="button"
              class="viewport-control"
              data-settings-tnoodle-enabled
              aria-pressed="false">Off</button
            >
          </div>
          <label class="settings-field">
            <span class="settings-row-label">TNoodle server URL</span>
            <input
              type="text"
              class="select-control"
              data-settings-tnoodle-url
              placeholder="http://localhost:2014"
              spellcheck="false"
            />
          </label>
          <label class="settings-field">
            <span class="settings-row-label">Event</span>
            <select class="select-control" data-settings-tnoodle-event>
              <option value="333">3×3×3 (333)</option>
            </select>
          </label>
          <div class="settings-row">
            <span class="settings-row-label" data-settings-tnoodle-status
              >TNoodle not checked.</span
            >
            <button
              type="button"
              class="transform-btn"
              data-settings-tnoodle-test>Test connection</button
            >
          </div>
          <label class="settings-field">
            <span class="settings-row-label">Inspection time (seconds)</span>
            <input
              type="number"
              class="select-control"
              data-settings-inspection-seconds
              min="1"
              step="1"
            />
          </label>
        </section>
      </dialog>
      <dialog
        class="manual-state-dialog"
        data-manual-state-dialog
        aria-labelledby="manual-state-title"
      >
        <div class="manual-state-header">
          <div class="manual-state-header-title">
            <h3 id="manual-state-title" data-manual-state-title class="panel-label">State Editor</h3>
          </div>
          <div class="manual-state-header-help">
            <p class="manual-state-intro">
              Pick a face colour, then fill the net. Nothing changes in Setup
              until the complete state is loaded.
            </p>
          </div>
        </div>
        <div class="manual-state-layout">
          <div class="manual-state-main">
            <div class="manual-state-controls-bar">
              <div class="manual-state-representation-switch" role="group" aria-label="Net representation">
                <button type="button" class="transform-btn" data-manual-state-representation="standard" aria-pressed="false">Flat net</button>
                <button type="button" class="transform-btn active" data-manual-state-representation="attached" aria-pressed="true">Folded net</button>
                <button type="button" class="transform-btn" data-manual-state-representation="isometric" aria-pressed="false">3D view</button>
              </div>
              <div class="manual-state-rotation-controls" data-manual-state-rotation-group role="group" aria-label="3D view orientation" hidden>
                <button type="button" class="transform-btn" data-manual-state-rotate="cw" aria-label="Rotate y (clockwise)" title="Rotate y (])">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg>
                  Rotate y
                </button>
                <button type="button" class="transform-btn" data-manual-state-rotate="ccw" aria-label="Rotate y' (counter-clockwise)" title="Rotate y' ([)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                  Rotate y'
                </button>
                <button type="button" class="transform-btn" data-manual-state-rotate="flip" aria-label="Flip upside down (x2)" title="Flip upside down via x2 (X)">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 8 4-4 4 4"></path><path d="M7 4v16"></path><path d="m21 16-4 4-4-4"></path><path d="M17 20V4"></path></svg>
                  Flip x2
                </button>
              </div>
            </div>
            <section
              class="manual-state-net"
              aria-label="Cube sticker net"
              data-manual-state-net
              data-representation="attached"
            >
              <div class="manual-state-net-faces" data-manual-state-grid></div>
            </section>
          </div>
          <section class="manual-state-tools" aria-label="State editor tools">
            <div class="manual-state-summary" data-manual-state-summary aria-live="polite"></div>
            <span class="panel-label">Sticker colour</span>
            <div class="manual-state-palette" data-manual-state-palette>
              <button type="button" class="manual-state-colour" data-manual-state-colour="U" aria-label="Up">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="manual-state-colour" data-manual-state-colour="D" aria-label="Down">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="transform-btn manual-state-tool" data-manual-state-eraser aria-pressed="false">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5 12 9l5.5 5.5-4 4h-5z"></path><path d="M9 20.5h11"></path></svg>
                Eraser
              </button>
              <button type="button" class="manual-state-colour" data-manual-state-colour="R" aria-label="Right">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="manual-state-colour" data-manual-state-colour="L" aria-label="Left">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="transform-btn manual-state-tool" data-manual-state-reset>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 1 0 2.6-5.7"></path><path d="M4.5 4v5h5"></path></svg>
                Reset
              </button>
              <button type="button" class="manual-state-colour" data-manual-state-colour="F" aria-label="Front">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="manual-state-colour" data-manual-state-colour="B" aria-label="Back">
                <span class="manual-state-colour-left" data-manual-state-colour-left></span>
              </button>
              <button type="button" class="transform-btn manual-state-tool" data-manual-state-solved>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 12.5 10 18 19.5 6.5"></path></svg>
                Solved
              </button>
            </div>
            <div class="manual-state-shortcuts">
              <span class="panel-label">Shortcuts</span>
              <div class="manual-state-shortcuts-grid">
                <div>
                  <span class="manual-state-key manual-state-face-key" aria-label="U R F D L B, or W R G Y O B">
                    <span data-face="U">U</span><span data-face="R">R</span><span data-face="F">F</span><span data-face="D">D</span><span data-face="L">L</span><span data-face="B">B</span>
                    <span data-face="U">W</span><span data-face="R">R</span><span data-face="F">G</span><span data-face="D">Y</span><span data-face="L">O</span><span data-face="B">B</span>
                  </span>
                </div>
                <div class="manual-state-shortcut-actions">
                  <div><span class="manual-state-key manual-state-key-emphasis">E</span>erase</div>
                  <div><span class="manual-state-key manual-state-key-emphasis">← ↑ ↓ →</span></div>
                  <div><span class="manual-state-key manual-state-key-emphasis">[ ]</span>rotate 3D</div>
                  <div><span class="manual-state-key manual-state-key-emphasis">X</span>flip 3D</div>
                </div>
              </div>
            </div>
            <div class="manual-state-copy-menu-wrap">
              <button
                type="button"
                class="transform-btn"
                data-manual-state-copy-toggle
                aria-haspopup="true"
                aria-expanded="false"
                disabled
              >Copy as … <span aria-hidden="true">▾</span></button>
              <div class="manual-state-copy-menu" data-manual-state-copy-menu hidden>
                <button type="button" data-manual-state-copy-format="compact">Compact facelets</button>
                <button type="button" data-manual-state-copy-format="spaced">Spaced facelets</button>
                <button type="button" data-manual-state-copy-format="singmaster">Singmaster cycle notation</button>
              </div>
            </div>
            <div class="manual-state-footer">
              <button type="button" class="viewport-control" data-manual-state-cancel>Cancel</button>
              <button type="button" class="transform-btn" data-manual-state-load disabled aria-label="Load state into Setup">Load</button>
            </div>
          </section>
        </div>
      </dialog>
    </main>

    <script>
      import "../client/converter";
      import { registerPwa } from "../client/pwa";

      registerPwa();
    </script>
  </body>
</html>
