---
import "../styles/global.css";

const cards = [
  {
    key: "facelets",
    title: "Compact Facelets",
    provenance: "Kociemba URFDLB row-major convention",
  },
  {key: "net", title: "Standard 2D Net", provenance: "Canonical U / L-F-R-B / D cross layout"},
  {
    key: "colours",
    title: "Compact Colours",
    provenance: "Facelets mapped through the active colour scheme",
  },
  {
    key: "colour-net",
    title: "Colour 2D Net",
    provenance: "Canonical cross layout using colour letters",
  },
  {
    key: "pieces",
    title: "3×3 CP / CO / EP / EO",
    provenance: "Kociemba piece order · canonical centre frame",
    sizes: "2,3",
  },
  {
    key: "orbit64",
    title: "Orbit64",
    provenance: "Normative v1 · 72-bit mixed radix · Base64URL",
    sizes: "3",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Convert Rubik's Cube states between facelets, ASCII nets, colour notation, cubie coordinates, and Orbit64."
    />
    <title>Cube Rosetta — Cube State Converter</title>
  </head>
  <body>
    <main class="container" data-converter>
      <header class="site-header">
        <span class="badge-tag">2×2×2 — 5×5×5</span>
        <h1 class="title-gradient">Cube Rosetta</h1>
        <p class="subtitle">Convert cube states into strict, copy-ready notation.</p>
      </header>

      <section class="toolbar" aria-label="Converter settings">
        <div class="toolbar-group">
          <span class="panel-label">Puzzle size</span>
          <div class="segmented-control" data-size-control>
            {[2, 3, 4, 5].map((size) => (
              <button
                type="button"
                class:list={["segmented-btn", {active: size === 3}]}
                data-size={size}
                aria-pressed={size === 3 ? "true" : "false"}
              >
                {size}×{size}×{size}
              </button>
            ))}
          </div>
        </div>

        <div class="toolbar-group">
          <label class="panel-label" for="scheme">Colour scheme</label>
          <select id="scheme" class="select-control" data-scheme>
            <option value="Western">Western (BOY)</option>
            <option value="Japanese">Japanese</option>
            <option value="Custom">Custom</option>
          </select>
          <label class="visually-hidden" for="custom-scheme">Custom mapping in U,L,F,R,B,D order</label>
          <input
            id="custom-scheme"
            class="select-control custom-scheme-input"
            data-custom-scheme
            value="WOGRBY"
            maxlength="6"
            spellcheck="false"
            aria-label="Custom mapping in U,L,F,R,B,D order"
            hidden
          />
        </div>

        <div class="toolbar-group" data-lowercase-controls hidden>
          <span class="panel-label">Lowercase moves</span>
          <div class="segmented-control" aria-label="Lowercase move interpretation">
            <button
              type="button"
              class="segmented-btn active"
              data-lowercase-mode="Wide"
              aria-pressed="true"
            >
              Wide (r = Rw)
            </button>
            <button
              type="button"
              class="segmented-btn"
              data-lowercase-mode="InnerSlice"
              aria-pressed="false"
            >
              Inner slice (r = 2R)
            </button>
          </div>
        </div>
      </section>

      <section class="input-panel">
        <div class="input-header">
          <label class="panel-label" for="cube-input">Algorithm or cube state</label>
          <span class="sniffer-badge" data-status aria-live="polite">Solved default</span>
        </div>
        <textarea
          id="cube-input"
          class="cube-textarea"
          data-input
          placeholder="Paste an algorithm, compact facelets, compact colours, or a canonical net. Leave blank for solved."
          spellcheck="false"
        ></textarea>
        <p class="input-help">
          Lowercase moves use modern SiGN wide turns by default (<code>r = Rw</code>).
          Use <code>2R</code> for a portable single inner-layer turn.
        </p>
        <div class="notation-banner" data-lowercase-banner role="status" hidden>
          <span data-lowercase-message></span>
          <button type="button" class="notation-action" data-switch-lowercase></button>
        </div>
        <div class="error-banner" data-error role="alert" hidden></div>
      </section>

      <section class="outputs-grid" aria-label="Converted state formats">
        {cards.map(({key, title, provenance, sizes}) => (
          <article class="output-card" data-output-card={key} data-sizes={sizes}>
            <header class="card-header">
              <h2 class="card-title" data-title={key}>{title}</h2>
              <button type="button" class="copy-btn" data-copy={key}>Copy</button>
            </header>
            <div class="card-body">
              <pre class="code-display"><code data-output={key}>—</code></pre>
              <p class="provenance-tag">{provenance}</p>
            </div>
          </article>
        ))}
      </section>

      <footer class="footer">Pure ReScript codecs · Vanilla Astro interface</footer>
    </main>

    <script>
      import "../client/converter";
    </script>
  </body>
</html>
