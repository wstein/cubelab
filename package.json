{
  "name": "cube-rosetta",
  "version": "0.0.0",
  "scripts": {
    "format": "rescript format src/*.res src/State/*.res src/Move/*.res",
    "format:check": "rescript format -c",
    "lint": "rescript format -c && rescript",
    "test": "rescript && node --test test/*.test.mjs",
    "test:browser": "bun run build && playwright test",
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch",
    "astro:dev": "astro dev",
    "astro:build": "astro build",
    "astro:preview": "astro preview",
    "build": "rescript && astro build",
    "preview": "astro preview"
  },
  "keywords": [
    "rescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "astro": "^7.2.10",
    "rescript": "12.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
