{
  "name": "cubelab",
  "version": "0.0.0",
  "scripts": {
    "format": "rescript format src/*.res src/State/*.res src/Move/*.res src/Render/*.res src/Solver/*.res src/SmartCube/*.res",
    "format:check": "rescript format -c",
    "lint": "rescript format -c && rescript",
    "test": "rescript && vitest run",
    "test:watch": "vitest",
    "test:browser": "bun run build && playwright test",
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript watch",
    "dev": "astro dev",
    "astro:dev": "astro dev",
    "astro:build": "astro build",
    "astro:preview": "astro preview",
    "build": "rescript && astro build",
    "preview": "astro preview",
    "patterns:import": "bun scripts/import-flix-patterns.ts",
    "solver:generate-2x2": "rescript && bun scripts/generate-optimal-2x2-table.ts",
    "benchmark:4x4": "bun scripts/benchmark-reduction-4x4.ts",
    "benchmark:4x4:release": "bun scripts/benchmark-reduction-4x4.ts --release"
  },
  "keywords": [
    "rescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "astro": "^7.2.10",
    "rescript": "12.3.1",
    "smartcube-web-bluetooth": "github:poliva/smartcube-web-bluetooth#44f1f091c6e980d9cc31e6d2863c4437eca3ab3c"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/aes-js": "3.1.4",
    "@types/node": "22.19.15",
    "rollup": "4.60.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "trustedDependencies": [
    "smartcube-web-bluetooth"
  ]
}
